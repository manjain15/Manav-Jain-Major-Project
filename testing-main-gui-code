import unittest
from unittest.mock import MagicMock, patch

from main import gui_handler

class TestGUIHandler(unittest.TestCase):

    def setUp(self):
        self.master = MagicMock()

    @patch('gui_handler.ctk')
    def test_start_screen(self, mock_ctk):
        gui = gui_handler(self.master)
        mock_ctk.CTkFrame.return_value = MagicMock()
        mock_ctk.CTkLabel.return_value = MagicMock()
        mock_ctk.CTkButton.return_value = MagicMock()

        gui.show_start_screen()
        
        self.assertIsNotNone(gui.current_screen)
        self.assertTrue(mock_ctk.CTkFrame.called)
        self.assertTrue(mock_ctk.CTkLabel.called)
        self.assertTrue(mock_ctk.CTkButton.called)
        # Add more assertions for specific elements if needed

